# Copy to .env. Keep .env out of version control.
APP_ENV=local
API_PORT=4187
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://vulnproof:vulnproof_local@localhost:5433/vulnproof
LOCAL_RPC_URL=http://127.0.0.1:8545
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ESCROW_ADDRESS=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_VERIFICATION_KEY=
# Local development only. Store random local tokens in an ignored file.
LOCAL_AUTH_FILE=
VITE_PRIVY_APP_ID=
GRAPH_ENDPOINT=
GRAPH_QUERY_KEY=
GRAPH_DEPLOYMENT_ID=
GRAPH_DEPLOY_KEY=
# Authenticate Circle Agent Stack with its CLI.
CIRCLE_AGENT_ADDRESS=
# OpenAI Responses API. The worker uses this key. Never expose it to Vite.
# Select a model that supports Structured Outputs.
MODEL_API_KEY=
MODEL_ID=
# Signer and report keys use the separate service secret files created by setup scripts.

# Separate service configuration. The API reads only its identity key.
SERVICE_PUBLIC_CONFIG=.local/config/public-services.json
API_IDENTITY_KEY=.local/keys/api-identity.json
REPORT_INTERNAL_URL=http://127.0.0.1:4194
REPORT_INTERNAL_PORT=4194
REPORT_KEY_DIRECTORY=.local/report-keys

WORKER_IDENTITY_KEY=.local/keys/worker-identity.json
VERIFIER_INTERNAL_URL=http://127.0.0.1:4191
VERIFIER_INTERNAL_PORT=4191
RESEARCHER_REPORT_PORT=4192
ORGANIZATION_REPORT_PORT=4193
EVIDENCE_DIRECTORY=.local/ciphertext/evidence
REPORT_DIRECTORY=.local/ciphertext/reports
